<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".library.ui.PlaylistFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/main_content"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:paddingBottom="264dp"
            android:theme="@style/Theme.PlaylistMaker.Playlist">

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/left_border"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintGuide_begin="@dimen/padding_default" />

            <androidx.constraintlayout.widget.Guideline
                android:id="@+id/right_border"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="vertical"
                app:layout_constraintGuide_end="@dimen/padding_default" />

            <FrameLayout
                android:id="@+id/playlist_cover"
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@id/name"
                app:layout_constraintDimensionRatio="h,1:1"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center"
                    android:layout_marginHorizontal="4dp"
                    android:src="@drawable/ic_placeholder_45" />

                <ImageView
                    android:id="@+id/back_button"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginTop="4dp"
                    android:background="@null"
                    android:backgroundTint="@null"
                    android:src="@drawable/ic_arrow_back_48" />
            </FrameLayout>

            <TextView
                android:id="@+id/name"
                style="@style/PlaylistPage.Name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/padding_large"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@id/description"
                app:layout_constraintEnd_toStartOf="@id/right_border"
                app:layout_constraintStart_toEndOf="@id/left_border"
                app:layout_constraintTop_toBottomOf="@id/playlist_cover"
                tools:text="Best songs" />

            <TextView
                android:id="@+id/description"
                style="@style/PlaylistPage.Info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/padding_small"
                app:layout_constrainedWidth="true"
                app:layout_constraintBottom_toTopOf="@id/length"
                app:layout_constraintEnd_toStartOf="@id/right_border"
                app:layout_constraintStart_toEndOf="@id/left_border"
                app:layout_constraintTop_toBottomOf="@id/name"
                tools:text="Description" />

            <TextView
                android:id="@+id/length"
                style="@style/PlaylistPage.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/padding_small"
                app:layout_constraintStart_toEndOf="@id/left_border"
                app:layout_constraintTop_toBottomOf="@id/description"
                tools:text="300 minutes" />

            <TextView
                android:id="@+id/separator"
                style="@style/PlaylistPage.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="5dp"
                android:text="@string/track_info_separator"
                android:textAlignment="center"
                app:layout_constraintBaseline_toBaselineOf="@id/length"
                app:layout_constraintStart_toEndOf="@id/length" />

            <TextView
                android:id="@+id/amount"
                style="@style/PlaylistPage.Info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBaseline_toBaselineOf="@id/length"
                app:layout_constraintStart_toEndOf="@id/separator"
                tools:text="98 tracks" />

            <ImageView
                android:id="@+id/share_button"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:layout_marginTop="@dimen/padding_default"
                android:src="@drawable/ic_share_24"
                app:layout_constraintStart_toEndOf="@id/left_border"
                app:layout_constraintTop_toBottomOf="@id/length" />

            <ImageView
                android:id="@+id/menu_button"
                android:layout_width="@dimen/icon_button_size"
                android:layout_height="@dimen/icon_button_size"
                android:layout_marginStart="@dimen/padding_default"
                android:src="@drawable/ic_menu_24"
                app:layout_constraintBottom_toBottomOf="@id/share_button"
                app:layout_constraintStart_toEndOf="@id/share_button" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/tracks_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bottom_sheet_bg"
        android:orientation="vertical"
        android:paddingVertical="@dimen/padding_large"
        app:behavior_fitToContents="false"
        app:behavior_hideable="false"
        app:behavior_peekHeight="240dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/track_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
    </LinearLayout>

    <View
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#99000000"
        android:visibility="gone" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/menu_bottom_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bottom_sheet_bg"
        android:clickable="true"
        android:paddingHorizontal="@dimen/padding_default"
        android:paddingVertical="@dimen/padding_large"
        app:behavior_fitToContents="true"
        app:behavior_hideable="true"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

        <ImageView
            android:id="@+id/card_image"
            android:layout_width="@dimen/track_image_size"
            android:layout_height="@dimen/track_image_size"
            android:layout_marginVertical="@dimen/padding_default"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:src="@drawable/ic_placeholder_45" />

        <TextView
            android:id="@+id/card_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/padding_small"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"
            android:textSize="12sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toTopOf="@id/card_amount"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/card_image"
            app:layout_constraintTop_toTopOf="@id/card_image"
            tools:text="Playlist name" />

        <TextView
            android:id="@+id/card_amount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_display_regular"
            android:textFontWeight="400"
            android:textSize="12sp"
            app:layout_constrainedWidth="true"
            app:layout_constraintBottom_toBottomOf="@id/card_image"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/card_name"
            app:layout_constraintTop_toBottomOf="@id/card_name"
            tools:text="420 треков" />

        <TextView
            android:id="@+id/menu_share"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:gravity="bottom"
            android:text="@string/playlist_share"
            android:textSize="@dimen/font_size_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/card_image" />

        <TextView
            android:id="@+id/menu_edit"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:gravity="bottom"
            android:text="@string/playlist_edit"
            android:textSize="@dimen/font_size_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menu_share" />

        <TextView
            android:id="@+id/menu_delete"
            android:layout_width="match_parent"
            android:layout_height="61dp"
            android:gravity="bottom"
            android:text="@string/playlist_delete"
            android:textSize="@dimen/font_size_small"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/menu_edit" />
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
